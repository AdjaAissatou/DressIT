# ============================================================================
#  DressIT — configuration (variables d'environnement)
# ============================================================================
#  1. Copiez ce fichier en « .env » à la racine du projet :
#         cp .env.example .env        (Windows :  copy .env.example .env)
#  2. Remplissez vos valeurs ci-dessous.
#  3. Le fichier « .env » n'est JAMAIS versionné (il est dans .gitignore).
#     N'y mettez jamais de vraie clé dans .env.example.
# ============================================================================

# --- Django : sécurité --------------------------------------------------------
# Générez une clé unique :  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DRESSIT_SECRET_KEY=changez-moi-par-une-cle-generee
# 1 = développement (messages d'erreur détaillés). 0 = production.
DRESSIT_DEBUG=1
# En production : listez vos domaines séparés par des virgules.
DRESSIT_ALLOWED_HOSTS=*
# En production : https://votre-domaine.com,https://www.votre-domaine.com
DRESSIT_CSRF_TRUSTED_ORIGINS=
# URL publique du site (utilisée pour les liens de retour de paiement et e-mails).
DRESSIT_SITE_URL=http://127.0.0.1:8000

# --- Paiement : Wave ----------------------------------------------------------
# Depuis le portail marchand Wave (Business). La clé commence par « wave_sn_ ».
# Tant que WAVE_API_KEY est vide, Wave n'est pas proposé (aucune simulation).
WAVE_API_KEY=
# Secret fourni par Wave lors de la configuration du webhook (signature HMAC).
WAVE_WEBHOOK_SECRET=

# --- Paiement : Orange Money --------------------------------------------------
# Depuis le portail développeur Orange (Orange Money Web Payment).
OM_MERCHANT_KEY=
# Option A : identifiants OAuth (Client ID / Secret de votre application Orange)
OM_CONSUMER_KEY=
OM_CONSUMER_SECRET=
# Option B (à la place de A) : en-tête "Basic xxxx" fourni tel quel par Orange
OM_AUTH_HEADER=
# "dev" = environnement de test Orange, "prod" = production.
OM_ENV=dev
# Devise (laisser vide : OUV en test, XOF en prod).
OM_CURRENCY=

# --- Studio IA (facultatif) ---------------------------------------------------
# Clé API Anthropic pour générer les descriptions avec Claude (console.anthropic.com).
ANTHROPIC_API_KEY=
# Fournisseur d'images IA facultatif (style OpenAI Images). Laisser vide sinon.
DRESSIT_IMAGE_API_URL=
DRESSIT_IMAGE_API_KEY=

# --- E-mails (facultatif en dev : les e-mails s'affichent dans la console) -----
# En production, configurez un vrai serveur SMTP :
DRESSIT_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DRESSIT_EMAIL_HOST=
DRESSIT_EMAIL_PORT=587
DRESSIT_EMAIL_HOST_USER=
DRESSIT_EMAIL_HOST_PASSWORD=
DRESSIT_EMAIL_USE_TLS=1
DRESSIT_FROM_EMAIL=DressIT <no-reply@dressit.local>
# Adresse qui reçoit les notifications internes (nouvelles réclamations, etc.).
DRESSIT_ADMIN_EMAIL=

# --- Boutique -----------------------------------------------------------------
DRESSIT_CURRENCY_SYMBOL=FCFA
DRESSIT_SHIPPING_FEE=2000
DRESSIT_FREE_SHIPPING_THRESHOLD=30000

# --- API mobile (CORS) --------------------------------------------------------
# Domaines autorisés à appeler l'API REST (app mobile / front séparé).
DRESSIT_CORS_ORIGINS=
